<%- include('../partials/head', { title: 'Students' }) %>
<div class="page-head">
  <h1>Students</h1>
  <p class="muted"><%= students.length %> registered</p>
</div>

<div class="card">
  <details>
    <summary>+ Add a student</summary>
    <form method="post" action="/admin/students">
      <div class="row">
        <div><label for="name">Full name</label><input id="name" name="name" required></div>
        <div><label for="student_no">Student number <span class="opt">(optional)</span></label><input id="student_no" name="student_no"></div>
      </div>
      <div class="row">
        <div><label for="email">Email</label><input id="email" name="email" type="email" required></div>
        <div><label for="phone">Phone number <span class="opt">(their login)</span></label><input id="phone" name="phone" type="tel" required></div>
      </div>
      <div class="row">
        <div>
          <label for="gender">Gender</label>
          <select id="gender" name="gender" required>
            <option value="">Choose…</option>
            <% Object.entries(GENDERS).forEach(([value, g]) => { %><option value="<%= value %>"><%= g.label %></option><% }) %>
          </select>
        </div>
        <div>
          <label for="room_id">Room <span class="opt">(only rooms for their gender are accepted)</span></label>
          <select id="room_id" name="room_id">
            <option value="">No room yet</option>
            <% rooms.forEach(r => { %><option value="<%= r.id %>">Room <%= r.id %> (<%= r.capacity - r.occupants %> free<%= r.for ? ', ' + GENDERS[r.for].group + ' only' : '' %>)</option><% }) %>
          </select>
        </div>
      </div>
      <div class="row">
        <div>
          <label for="password">Starting password <span class="opt">(at least 6 characters)</span></label>
          <input id="password" name="password" type="text" autocomplete="off" minlength="6" required>
        </div>
      </div>
      <button class="btn" type="submit">Add student</button>
    </form>
  </details>
</div>

<div class="card table-wrap">
  <% if (!students.length) { %><p class="empty">No students have registered yet.</p><% } else { %>
  <table>
    <thead><tr><th>Name</th><th>Gender</th><th>Student no.</th><th>Contact</th><th>Room</th><th>Rating</th><th></th></tr></thead>
    <tbody>
      <% students.forEach(s => { %>
        <tr>
          <td><b><%= s.name %></b></td>
          <td><% if (GENDERS[s.gender]) { %><span class="badge <%= s.gender %>"><%= GENDERS[s.gender].label %></span><% } else { %><span class="badge pending">Not given</span><% } %></td>
          <td><%= s.student_no || '—' %></td>
          <td><%= s.email %><br><span class="muted"><%= s.phone %></span></td>
          <td><% if (s.room_id) { %><a href="/admin/rooms/<%= s.room_id %>">Room <%= s.room_id %></a><% } else { %><span class="badge">No room</span><% } %></td>
          <td><%= s.avg_rating ? s.avg_rating.toFixed(1) + ' ★' : '—' %></td>
          <td><a class="btn sm ghost" href="/admin/students/<%= s.id %>">Edit</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('../partials/foot') %>
