<%- include('../partials/head', { title: 'Room ' + room.id }) %>
<div class="page-head">
  <p class="small"><a href="/admin">← All rooms</a></p>
  <h1>Room <%= room.id %> <span class="badge <%= room.status %>"><%= statusLabel[room.status] %></span></h1>
  <p class="muted"><%= room.status === 'reserved' ? 'This room is reserved and not available to students.' : `${room.occupants} of ${room.capacity} bedspaces taken` %></p>
</div>

<div class="grid2">
  <div class="card">
    <h2>Occupants</h2>
    <% if (!occupants.length) { %><p class="muted"><%= room.status === 'reserved' ? 'Reserved rooms have no student occupants.' : 'Nobody is registered in this room, so it is vacant.' %></p><% } %>
    <% occupants.forEach(o => { %>
      <div class="item">
        <div class="item-head">
          <div>
            <b><%= o.name %></b><br>
            <span class="muted small"><%= o.student_no || 'No student number' %> · <%= o.phone || o.email %></span><br>
            <% if (o.checked_in_at) { %>
              <span class="badge approved">Checked in <%= fmtDate(o.checked_in_at) %></span>
            <% } else { %>
              <span class="badge pending">Not checked in yet</span>
            <% } %>
          </div>
          <div class="actions-row">
            <a class="btn sm ghost" href="/admin/students/<%= o.id %>">Edit</a>
            <form class="inline" method="post" action="/admin/rooms/<%= room.id %>/remove" onsubmit="return confirm('Remove this occupant from Room <%= room.id %>?')">
              <input type="hidden" name="user_id" value="<%= o.id %>">
              <button class="btn sm danger" type="submit">Remove</button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>

    <% if (room.status === 'vacant' || room.status === 'available') { %>
      <h2 style="margin-top:20px">Add an occupant</h2>
      <% if (!unassigned.length) { %>
        <p class="muted small">There are no students without a room. <a href="/admin/students">Add a new student</a> or move one from their edit page.</p>
      <% } else { %>
        <form class="actions-row" method="post" action="/admin/rooms/<%= room.id %>/assign">
          <select name="user_id" aria-label="Student to add" required>
            <option value="">Choose a student…</option>
            <% unassigned.forEach(u => { %><option value="<%= u.id %>"><%= u.name %><%= u.student_no ? ' (' + u.student_no + ')' : '' %></option><% }) %>
          </select>
          <button class="btn sm" type="submit">Add to room</button>
        </form>
      <% } %>
    <% } %>
  </div>

  <div>
    <% if (qr) { %>
      <div class="card qr-card">
        <h2>Room <%= room.id %> QR code</h2>
        <p class="muted small no-print">Show this code to a student. When they scan it (from “Scan QR code” in their account, or with their phone camera) they are assigned to Room <%= room.id %> and checked in. It only works while the room has a free bedspace.</p>
        <div class="qr"><img src="<%= qr.svg %>" alt="QR code for Room <%= room.id %>" width="240" height="240"></div>
        <p class="qr-room">Room <%= room.id %></p>
        <p class="qr-code">Code: <b><%= room.qr_code %></b></p>
        <div class="actions-row no-print" style="justify-content:center">
          <button class="btn sm ghost" type="button" onclick="window.print()">Print QR code</button>
          <%# room-qr.js turns this into a picture of the card (logo, room, QR code and room code).
              Without scripts it downloads the plain QR code. %>
          <a class="btn sm ghost" href="<%= qr.png %>" download="Royalty-Room-<%= room.id %>-QR.png"
             data-qr-card data-room="<%= room.id %>" data-code="<%= room.qr_code %>">Download</a>
          <form class="inline" method="post" action="/admin/rooms/<%= room.id %>/qr" onsubmit="return confirm('Make a new QR code for Room <%= room.id %>? The current one will stop working.')">
            <button class="btn sm ghost" type="submit">New QR code</button>
          </form>
        </div>
      </div>
    <% } %>

    <div class="card">
      <h2>Room details</h2>
      <form method="post" action="/admin/rooms/<%= room.id %>">
        <p><b><%= room.capacity %> bedspaces</b> <span class="muted small">(fixed for this room)</span></p>
        <label for="rent">Monthly rent per student (<%= settings.currency %>)</label>
        <input id="rent" name="rent" type="number" min="0" step="0.01" value="<%= room.rent %>" required>
        <button class="btn" type="submit">Save</button>
      </form>
    </div>

    <% if (occupants.length) { %>
      <div class="card">
        <h2>Mark room vacant</h2>
        <p class="muted small">Removes every occupant from this room. Their accounts, payments and reports are kept.</p>
        <form method="post" action="/admin/rooms/<%= room.id %>/vacate" onsubmit="return confirm('Remove all occupants and mark Room <%= room.id %> vacant?')">
          <button class="btn danger" type="submit" style="margin-top:0">Mark vacant</button>
        </form>
      </div>
    <% } %>
  </div>
</div>
<script src="/room-qr.js"></script>
<%- include('../partials/foot') %>
