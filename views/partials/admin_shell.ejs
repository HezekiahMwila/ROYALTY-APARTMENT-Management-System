<%# The frame around every admin page on a computer: the side menu, and the top row saying
    where you are with the theme switch and your account. partials/head.ejs adds it for the
    admin automatically. On a phone both are hidden and the usual top bar is used instead.
    Needs title (the page's name) and waitingCounts (set for the admin in server.js).
    Styles are in /admin.css. %>
<%
  const PIC = {
    home: '<path d="M3.5 11 12 4l8.500 7M5.500 9.500V20h13V9.500M10 20v-5.500h4V20"/>',
    students: '<circle cx="9" cy="8" r="3.5"/><path d="M2.500 20c.5-3.600 3.100-5.500 6.500-5.500s6 1.900 6.500 5.500M16 4.800a3.500 3.500 0 0 1 0 6.400M18.500 14.800c1.800.7 2.800 2.400 3 5.200"/>',
    payments: '<rect x="2.5" y="5.5" width="19" height="13" rx="2.5"/><path d="M2.500 10h19M6.500 15h4"/>',
    problems: '<path d="M12 3.5 2.500 20h19L12 3.500ZM12 10v4.500"/><circle cx="12" cy="17.2" r=".6" fill="currentColor"/>',
    ratings: '<path d="m12 3.5 2.600 5.400 5.900.8-4.300 4.100 1 5.900L12 16.900l-5.200 2.800 1-5.900-4.300-4.100 5.900-.8L12 3.500Z"/>',
    settings: '<circle cx="12" cy="12" r="3"/><path d="M12 2.800v2.400M12 18.800v2.400M2.800 12h2.400M18.800 12h2.400M5.500 5.500l1.700 1.700M16.800 16.800l1.700 1.700M18.500 5.500l-1.700 1.700M7.200 16.800l-1.700 1.700"/>',
    account: '<circle cx="12" cy="8" r="3.8"/><path d="M4.500 20c.6-3.900 3.600-6 7.500-6s6.900 2.100 7.500 6"/>',
    logout: '<path d="M14 4.5h3.500a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H14M10 8l-4 4 4 4M6 12h9"/>',
    calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.500 10h17M8 3v4M16 3v4"/>',
    page: '<path d="M6.5 3.5h7l4 4v13h-11v-17ZM13.500 3.500v4h4"/>',
  };
  const pic = (name) => `<svg viewBox="0 0 24 24" aria-hidden="true">${PIC[name]}</svg>`;
  const menu = [['/admin', 'Dashboard', 'home'], ['/admin/students', 'Students', 'students'], ['/admin/payments', 'Payments', 'payments'], ['/admin/problems', 'Problems', 'problems'], ['/admin/ratings', 'Ratings', 'ratings']];
  const below = [['/admin/settings', 'Settings', 'settings'], ['/account', 'Account', 'account']];
  // A room's page belongs to the Dashboard; every other link lights up on its own pages.
  const lit = (href) => href === '/admin' ? (path === '/admin' || path.startsWith('/admin/rooms')) : (path === href || path.startsWith(href + '/'));
  const waitingFor = { '/admin/payments': waitingCounts.payments, '/admin/problems': waitingCounts.problems };
  const onDashboard = path === '/admin';
  const shortDate = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
%>
<aside class="ad-side" aria-label="Admin menu">
  <a class="ad-side-logo" href="/"><img src="/logo.svg" alt="Royalty Apartments home page" width="1757" height="1067"></a>
  <nav class="ad-side-nav">
    <% menu.forEach(([href, label, name]) => { %>
      <a href="<%= href %>" class="<%= lit(href) ? 'on' : '' %>" <%- lit(href) ? 'aria-current="page"' : '' %>><span><%- pic(name) %></span><%= label %><% if (waitingFor[href]) { %><b><%= waitingFor[href] %></b><% } %></a>
    <% }) %>
  </nav>
  <nav class="ad-side-nav ad-side-foot">
    <% below.forEach(([href, label, name]) => { %>
      <a href="<%= href %>" class="<%= lit(href) ? 'on' : '' %>" <%- lit(href) ? 'aria-current="page"' : '' %>><span><%- pic(name) %></span><%= label %></a>
    <% }) %>
    <form method="post" action="/logout"><button type="submit"><span><%- pic('logout') %></span>Log out</button></form>
  </nav>
</aside>

<div class="ad-top">
  <nav class="ad-crumbs" aria-label="You are here">
    <a href="/"><%- pic('home') %>Home</a><i>/</i>
    <% if (onDashboard) { %><span><%- pic('home') %>Dashboard</span><% } else { %><a href="/admin"><%- pic('home') %>Dashboard</a><i>/</i><span><%- pic('page') %><%= title %></span><% } %>
    <i>/</i><span class="ad-crumb-date"><%- pic('calendar') %><%= shortDate %></span>
  </nav>
  <div class="ad-tools">
    <%- include('theme_toggle') %>
    <a class="ad-avatar" href="/account" title="Your account: <%= user.name %>" aria-label="Your account"><%= user.name.charAt(0).toUpperCase() %></a>
  </div>
</div>
