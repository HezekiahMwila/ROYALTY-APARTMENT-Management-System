<%# Password box for the glass sign-in pages, with the show / hide eye.
    Pass placeholder and autocomplete; minlength is optional. %>
      <label class="lg-sr" for="password"><%= placeholder %></label>
      <div class="lg-field">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M7.5 10V7.8a4.5 4.5 0 0 1 9 0V10h.7c1 0 1.800.8 1.800 1.800v7.400c0 1-.8 1.800-1.800 1.800H6.800c-1 0-1.800-.8-1.800-1.800v-7.400c0-1 .8-1.800 1.800-1.800h.7Zm2 0h5V7.800a2.500 2.500 0 0 0-5 0V10Zm2.500 3.600a1.400 1.400 0 0 0-.7 2.600v1.500h1.400v-1.500a1.400 1.400 0 0 0-.7-2.600Z"/></svg>
        <input id="password" name="password" type="password" placeholder="<%= placeholder %>" autocomplete="<%= autocomplete %>"<% if (locals.minlength) { %> minlength="<%= minlength %>"<% } %> required>
        <button class="lg-eye" type="button" data-show-password aria-pressed="false" aria-label="Show password" title="Show or hide the password">
          <svg class="lg-eye-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18M10.6 6.2A9.700 9.700 0 0 1 12 6.100c4.400 0 7.600 2.900 9.200 5.900a12.500 12.500 0 0 1-2.500 3.300M6.300 7.700A12.400 12.400 0 0 0 2.800 12c1.600 3 4.800 5.900 9.200 5.900 1.300 0 2.500-.25 3.600-.7M9.900 9.900a3 3 0 0 0 4.200 4.200"/></svg>
          <svg class="lg-eye-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.800 12C4.400 9 7.600 6.100 12 6.100S19.600 9 21.200 12c-1.600 3-4.800 5.900-9.200 5.900S4.400 15 2.800 12Z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
      </div>
