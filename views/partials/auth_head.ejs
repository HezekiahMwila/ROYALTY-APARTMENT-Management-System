<%# Sign-in pages (log in, register, first-time setup): apartment photo on the left, form on the right. %>
<!doctype html>
<html lang="en">
<head>
<%- include('meta', { title }) %>
</head>
<body class="auth">
<% const today = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).replace(',', ''); %>
<div class="auth-split">
  <aside class="auth-photo" style="background-image:url('<%= photo(1) %>')">
    <a class="auth-logo" href="/"><img src="/logo.svg" alt="Royalty Apartments home page" width="113" height="62"></a>
    <div class="auth-caption">
      <b>Royalty Apartments</b>
      <span><%= today %></span>
    </div>
  </aside>
  <main class="auth-panel">
    <div class="auth-top"><%- include('theme_toggle') %></div>
    <div class="card auth-card">
      <% if (flash) { %><div class="flash <%= flash.type === 'ok' ? 'ok' : 'error' %>" role="status"><%= flash.text %></div><% } %>
