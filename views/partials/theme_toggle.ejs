<%# Day / night switch. theme.js keeps the label and pressed state in step with the theme. %>
<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="true" title="Switch between light and dark mode">
  <span class="tt-track" aria-hidden="true"><span class="tt-knob"></span></span>
  <span class="tt-label">Light mode</span>
</button>
