<!doctype html>
<html lang="en">
<head>
<%- include('meta', { title }) %>
</head>
<body class="<%= locals.bodyClass || '' %>">
<%
  const links = !user
    ? [['/', 'Home'], ['/login', 'Log in'], ['/register', 'Register']]
    : user.role === 'admin'
      ? [['/', 'Home'], ['/admin', 'Overview'], ['/admin/students', 'Students'], ['/admin/payments', 'Payments'], ['/admin/problems', 'Problems'], ['/admin/ratings', 'Ratings'], ['/admin/settings', 'Settings'], ['/account', 'Account']]
      : [['/student', 'Home'], ['/student/room', 'My room'], ['/student/scan', 'Scan QR'], ['/student/payments', 'Payments'], ['/student/problems', 'Problems'], ['/student/roommates', 'Roommates'], ['/account', 'Account']];
  const exact = ['/', '/admin', '/student'];
  // A menu link is highlighted on its own page and on pages beneath it ("/student/room" must not
  // light up for "/student/roommates").
  const isOn = (href) => exact.includes(href) ? (path === href || (href === '/admin' && path.startsWith('/admin/rooms'))) : (path === href || path.startsWith(href + '/'));
%>
<%# Top bar: menu button on the left, logo in the middle, theme switch on the right.
    The menu is a <details> element, so it opens even if scripts are switched off. %>
<header class="top">
  <details class="menu">
    <summary class="menu-btn" aria-label="Menu" title="Menu"><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span></summary>
    <nav class="menu-panel" aria-label="Main menu">
      <% links.forEach(([href, label], i) => { %>
        <a href="<%= href %>" class="<%= isOn(href) ? 'on' : '' %>" style="--i:<%= i %>" <%- isOn(href) ? 'aria-current="page"' : '' %>><%= label %></a>
      <% }) %>
      <% if (user) { %><form method="post" action="/logout"><button class="logout" type="submit">Log out</button></form><% } %>
    </nav>
  </details>
  <a class="brand" href="/"><img src="/logo.svg" alt="Royalty Apartments" width="102" height="56"></a>
  <%- include('theme_toggle') %>
</header>
<main class="wrap">
<% if (flash) { %><div class="flash <%= flash.type === 'ok' ? 'ok' : 'error' %>" role="status"><%= flash.text %></div><% } %>
