<%# Shared <head> contents for every page. %>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Royalty Apartments</title>
  <meta name="theme-color" content="#123fdc">
  <%# Tab icon: .ico for older browsers and .svg for the rest, both the roof and house from logo.svg.
      The phone home-screen / app icons (icon-180.png and the ones in the manifest) are the full logo. %>
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon-180.png?v=2">
  <%# Installable app: name, icons and colours are in manifest.webmanifest; app.js registers sw.js. %>
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Royalty">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <script src="/app.js" defer></script>
  <script>
    // Apply the saved theme before the page is drawn, so it never flashes the wrong one.
    // Dark is the default until the visitor picks light.
    (function () {
      var theme = 'dark';
      try { if (localStorage.getItem('theme') === 'light') theme = 'light'; } catch (e) {}
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <link rel="stylesheet" href="/style.css">
