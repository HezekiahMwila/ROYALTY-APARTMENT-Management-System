<%# Shared <head> contents for every page. %>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Royalty Apartments</title>
  <meta name="theme-color" content="#123fdc">
  <%# Tab icon: .ico for older browsers, .svg for the rest, and a .png for phone home screens.
      All three are the roof and house from logo.svg. %>
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon-180.png">
  <script>
    // Apply the saved theme before the page is drawn, so it never flashes the wrong one.
    // Dark is the default until the visitor picks light.
    (function () {
      var theme = 'dark';
      try { if (localStorage.getItem('theme') === 'light') theme = 'light'; } catch (e) {}
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <link rel="stylesheet" href="/style.css">
