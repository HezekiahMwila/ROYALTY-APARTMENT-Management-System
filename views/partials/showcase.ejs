<%# Apartment pictures and services, shown on the public and student homepages.
    The pictures fill the whole browser window behind the page and change by themselves. %>
<div class="backdrop" data-slideshow aria-hidden="true">
  <% slides.forEach((s, i) => { %>
    <figure class="slide <%= i === 0 ? 'on' : '' %>"><img <%= i === 0 ? 'src' : 'data-src' %>="<%= s.src %>" alt=""></figure>
  <% }) %>
</div>

<% const many = slides.length > 1; %>
<% if (many || slides[0].caption) { %>
<div class="slide-ctrl <%= many ? '' : 'solo' %>" role="group" aria-label="Apartment pictures">
  <% if (many) { %>
    <button class="slide-btn prev" type="button" aria-label="Previous picture">‹</button>
    <div class="slide-dots">
      <% slides.forEach((s, i) => { %><button type="button" class="<%= i === 0 ? 'on' : '' %>" aria-label="Show picture <%= i + 1 %> of <%= slides.length %>"></button><% }) %>
    </div>
    <button class="slide-btn next" type="button" aria-label="Next picture">›</button>
  <% } %>
  <span class="slide-caption" aria-live="polite"><%= slides[0].caption %></span>
</div>
<% } %>

<% if (many) { %>
<script>
  // Background slideshow: a new picture every 5 seconds. It pauses while the pointer or
  // keyboard focus is on the controls, and does not auto-play if the visitor prefers less motion.
  (function () {
    var slides = [].slice.call(document.querySelectorAll('.backdrop .slide'));
    var ctrl = document.querySelector('.slide-ctrl');
    var dots = [].slice.call(ctrl.querySelectorAll('.slide-dots button'));
    var caption = ctrl.querySelector('.slide-caption');
    var captions = <%- JSON.stringify(slides.map(s => s.caption || '')).replace(/</g, '\\u003c') %>;
    var current = 0, timer = null;
    // Only the first picture comes with the page; each other one is fetched just before it is needed.
    function fetchSlide(i) {
      var img = slides[i] && slides[i].querySelector('img[data-src]');
      if (img) { img.src = img.getAttribute('data-src'); img.removeAttribute('data-src'); }
    }
    function show(n) {
      current = (n + slides.length) % slides.length;
      fetchSlide(current);
      fetchSlide((current + 1) % slides.length);
      slides.forEach(function (s, i) { s.classList.toggle('on', i === current); });
      dots.forEach(function (d, i) { d.classList.toggle('on', i === current); });
      caption.textContent = captions[current];
    }
    function stop() { clearInterval(timer); timer = null; }
    function start() {
      if (timer || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = setInterval(function () { show(current + 1); }, 5000);
    }
    ctrl.querySelector('.prev').addEventListener('click', function () { show(current - 1); });
    ctrl.querySelector('.next').addEventListener('click', function () { show(current + 1); });
    dots.forEach(function (d, i) { d.addEventListener('click', function () { show(i); }); });
    ctrl.addEventListener('mouseenter', stop);
    ctrl.addEventListener('mouseleave', start);
    ctrl.addEventListener('focusin', stop);
    ctrl.addEventListener('focusout', start);
    fetchSlide(1);
    start();
  })();
</script>
<% } %>

<% if (services.length) { %>
<section class="section">
  <h2>Services offered</h2>
  <ul class="services">
    <% services.forEach(s => { %><li><%= s %></li><% }) %>
  </ul>
</section>
<% } %>
