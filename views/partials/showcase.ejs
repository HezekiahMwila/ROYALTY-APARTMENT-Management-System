<%# Apartment slideshow and services, shown on the public and student homepages. %>
<%
  // The slideshow shows these pictures of Royalty Apartments (in public/slides) until the
  // caretaker uploads photos in Settings; uploaded photos then take their place.
  const DEFAULT_SLIDES = ['Entrance and parking', 'Shaded sitting area', 'Outdoor lounge', 'Bedroom', 'Washing area'];
  const slides = photos.length
    ? photos.map(p => ({ src: `/photos/${p.file}`, caption: p.caption }))
    : DEFAULT_SLIDES.map((caption, i) => ({ src: `/slides/slide-${i + 1}.jpg`, caption }));
%>
<section class="section">
  <h2>Our apartments</h2>
  <div class="slideshow" data-slideshow aria-roledescription="carousel" aria-label="Photos of Royalty Apartments">
    <div class="slides">
      <% slides.forEach((s, i) => { %>
        <figure class="slide <%= i === 0 ? 'on' : '' %>" aria-hidden="<%= i === 0 ? 'false' : 'true' %>">
          <%# A blurred copy fills the frame behind the picture, so upright photos are shown whole instead of cropped. %>
          <div class="slide-bg" style="background-image:url('<%= s.src %>')" aria-hidden="true"></div>
          <img src="<%= s.src %>" alt="<%= s.caption || 'Royalty Apartments' %>">
          <% if (s.caption) { %><figcaption><%= s.caption %></figcaption><% } %>
        </figure>
      <% }) %>
    </div>
    <% if (slides.length > 1) { %>
      <button class="slide-btn prev" type="button" aria-label="Previous picture">‹</button>
      <button class="slide-btn next" type="button" aria-label="Next picture">›</button>
      <div class="slide-dots">
        <% slides.forEach((s, i) => { %><button type="button" class="<%= i === 0 ? 'on' : '' %>" aria-label="Show picture <%= i + 1 %>"></button><% }) %>
      </div>
    <% } %>
  </div>
</section>

<script>
  // Slideshow: changes picture every 2 seconds, pauses while the pointer or keyboard focus is on it.
  document.querySelectorAll('[data-slideshow]').forEach((box) => {
    const slides = [...box.querySelectorAll('.slide')];
    const dots = [...box.querySelectorAll('.slide-dots button')];
    if (slides.length < 2) return;
    let current = 0, timer = null;
    const show = (n) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => { s.classList.toggle('on', i === current); s.setAttribute('aria-hidden', i !== current); });
      dots.forEach((d, i) => d.classList.toggle('on', i === current));
    };
    const stop = () => { clearInterval(timer); timer = null; };
    const start = () => {
      if (timer || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = setInterval(() => show(current + 1), 2000);
    };
    box.querySelector('.prev').addEventListener('click', () => show(current - 1));
    box.querySelector('.next').addEventListener('click', () => show(current + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
    box.addEventListener('mouseenter', stop);
    box.addEventListener('mouseleave', start);
    box.addEventListener('focusin', stop);
    box.addEventListener('focusout', start);
    start();
  });
</script>

<% if (services.length) { %>
<section class="section">
  <h2>Services offered</h2>
  <ul class="services">
    <% services.forEach(s => { %><li><%= s %></li><% }) %>
  </ul>
</section>
<% } %>
