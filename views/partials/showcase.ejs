<%# Apartment photos and services, shown on the public and student homepages. %>
<section class="section">
  <h2>Our apartments</h2>
  <% if (!photos.length) { %>
    <div class="card muted">Photos of the apartments will be added soon.</div>
  <% } else { %>
    <div class="gallery">
      <% photos.forEach(p => { %>
        <figure>
          <img src="/photos/<%= p.file %>" alt="<%= p.caption || 'Royalty Apartments' %>" loading="lazy">
          <% if (p.caption) { %><figcaption><%= p.caption %></figcaption><% } %>
        </figure>
      <% }) %>
    </div>
  <% } %>
</section>

<% if (services.length) { %>
<section class="section">
  <h2>Services offered</h2>
  <ul class="services">
    <% services.forEach(s => { %><li><%= s %></li><% }) %>
  </ul>
</section>
<% } %>
