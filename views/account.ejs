<%- include('partials/head', { title: 'Account' }) %>
<div class="card narrow">
  <h1>My account</h1>
  <p class="muted"><%= user.name %> · <%= user.email %></p>
  <h2 style="margin-top:20px">Change password</h2>
  <form method="post" action="/account/password">
    <label for="current_password">Current password</label>
    <input id="current_password" name="current_password" type="password" autocomplete="current-password" required>
    <label for="new_password">New password <span class="opt">(at least 6 characters)</span></label>
    <input id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="6" required>
    <button class="btn" type="submit">Change password</button>
  </form>
</div>
<%- include('partials/foot') %>
