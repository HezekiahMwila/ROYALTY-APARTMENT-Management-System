<%- include('partials/head', { title: 'First-time setup' }) %>
<div class="card narrow">
  <h1>First-time setup</h1>
  <p class="muted">Create the admin account for Royalty Apartments. This page only appears once.</p>
  <form method="post" action="/setup">
    <label for="name">Admin name</label>
    <input id="name" name="name" required autofocus>
    <label for="email">Email</label>
    <input id="email" name="email" type="email" autocomplete="email" required>
    <label for="password">Password <span class="opt">(at least 6 characters)</span></label>
    <input id="password" name="password" type="password" autocomplete="new-password" minlength="6" required>
    <button class="btn" type="submit">Create admin account</button>
  </form>
</div>
<%- include('partials/foot') %>
