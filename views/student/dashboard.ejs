<%- include('../partials/head', { title: 'My room' }) %>
<% const initials = user.name.split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase(); %>

<div class="card profile">
  <% if (user.photo) { %>
    <img class="avatar" src="/uploads/<%= user.photo %>" alt="Profile picture of <%= user.name %>">
  <% } else { %>
    <div class="avatar placeholder" aria-hidden="true"><%= initials %></div>
  <% } %>
  <div class="profile-info">
    <h1><%= user.name %></h1>
    <p class="muted"><%= user.phone %></p>
    <form class="actions-row" method="post" action="/student/photo" enctype="multipart/form-data">
      <input name="photo" type="file" accept="image/png,image/jpeg,image/webp" aria-label="Profile picture" required>
      <button class="btn sm" type="submit"><%= user.photo ? 'Change picture' : 'Upload picture' %></button>
    </form>
  </div>
</div>

<% if (!room) { %>
  <div class="card">
    <h2>No room yet</h2>
    <p class="muted">Ask the caretaker to show you the QR code for your room, then scan it to be assigned to that room.</p>
    <a class="btn accent" href="/student/scan">Scan room QR code</a>
  </div>
<% } else { %>
  <% if (user.checked_in_at) { %>
    <div class="checkin done"><b>Checked in to Room <%= room.id %></b> on <%= fmtDate(user.checked_in_at) %>.</div>
  <% } else { %>
    <div class="checkin"><b>You have not checked in yet.</b> Ask the caretaker to show you the Room <%= room.id %> QR code, then <a href="/student/scan">scan it to check in</a>.</div>
  <% } %>
  <div class="banner" style="background-image:url('<%= photo(0) %>')">
    <div class="banner-head"><h2>My room</h2></div>
    <div class="stats">
      <div class="stat"><b>Room <%= room.id %></b><span>Room number</span></div>
      <div class="stat"><b><%= room.rent > 0 ? money(room.rent) : '—' %></b><span>Monthly rent</span></div>
      <a class="stat" href="/student/problems"><b><%= openProblems %></b><span>Open problem reports</span></a>
    </div>
  </div>

  <div class="card">
    <h2><%= roommates.length === 1 ? 'Your roommate' : 'Your roommates' %></h2>
    <% if (!roommates.length) { %>
      <p class="muted" style="margin:0">You have no roommates right now.</p>
    <% } else { %>
      <p class="muted small">Their contact details, so you can reach each other in an emergency.</p>
      <% roommates.forEach(m => { %><%- include('../partials/roommate_contact', { m }) %><% }) %>
    <% } %>
    <p class="muted small mate-note">Your roommates can see your name, picture, phone number, email and student number in the same way.</p>
  </div>
<% } %>
<%- include('../partials/foot') %>
